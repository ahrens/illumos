#
# Helpers for testing how the pool behaves when it suspends. The pool is
# built on a single file vdev. To suspend it, we make all writes to the
# vdev fail, and also make the probe that follows a write failure fail
# (vdev_probe() does its I/O to the vl_be area of the labels, which is
# what "zinject -L pad2" covers). The next txg sync then cannot write
# anywhere, and the pool suspends. Clearing the injections and running
# "zpool clear" resumes it.
#

FAILMODE_VDEV=$TEST_BASE_DIR/failmode_vdev

function failmode_create_pool # failmode
{
	log_must mkfile $MINVDEVSIZE $FAILMODE_VDEV
	log_must zpool create -f -o failmode=$1 $TESTPOOL $FAILMODE_VDEV
	log_must zfs create -o recordsize=128k $TESTPOOL/$TESTFS
}

#
# Is the pool suspended?  This asks the kernel rather than "zpool status",
# which needs spa_namespace_lock, and a command sleeping on the suspended pool
# may hold that.
#
function pool_is_suspended # pool
{
	typeset fmt='::printf "%s %d\n" spa_t spa_name spa_suspended'
	typeset susp=$(print -r -- "::walk spa | $fmt" | mdb -k |
	    nawk -v pool=$1 '$1 == pool { print $2 }')
	[[ -n $susp && $susp != 0 ]]
}

function failmode_suspend_pool
{
	log_must zinject -d $FAILMODE_VDEV -e io -T write $TESTPOOL
	log_must zinject -d $FAILMODE_VDEV -L pad2 $TESTPOOL

	# Dirty some data, so that the next txg sync has to write something.
	log_must dd if=/dev/urandom of=/$TESTPOOL/$TESTFS/dirty bs=128k count=8

	log_note "waiting for pool to suspend"
	typeset -i tries=30
	until pool_is_suspended $TESTPOOL; do
		if ((tries-- == 0)); then
			log_fail "pool didn't suspend"
		fi
		sleep 1
	done
}

#
# Has the pool failed (see spa_fail() in the kernel)?  A failed pool is not
# suspended, so zpool status can't tell yet; ask the kernel.
#
function pool_has_failed # pool
{
	typeset fmt='::printf "%s %d\n" spa_t spa_name spa_exit'
	typeset state=$(print -r -- "::walk spa | $fmt" | mdb -k |
	    nawk -v pool=$1 '$1 == pool { print $2 }')
	[[ $state == 2 ]]
}

#
# Make every write to the vdev fail, so that the next txg sync that has
# something to write fails the pool (failmode=death, or a pool armed by
# "zpool export -F") or suspends it.
#
function failmode_break_vdev
{
	log_must zinject -d $FAILMODE_VDEV -e io -T write $TESTPOOL
	log_must zinject -d $FAILMODE_VDEV -L pad2 $TESTPOOL
}

function failmode_wait_failed # pool
{
	log_note "waiting for $1 to fail"
	typeset -i tries=30
	until pool_has_failed $1; do
		if ((tries-- == 0)); then
			log_fail "$1 didn't fail"
		fi
		sleep 1
	done
}

#
# Wait for a pool whose writes now fail to stop: a death pool fails, any
# other suspends.
#
function failmode_wait_stopped # pool failmode
{
	if [[ $2 == death ]]; then
		failmode_wait_failed $1
		return
	fi
	log_note "waiting for $1 to suspend"
	typeset -i tries=30
	until pool_is_suspended $1; do
		if ((tries-- == 0)); then
			log_fail "$1 didn't suspend"
		fi
		sleep 1
	done
}

#
# Checksum of a vdev file, to tell whether anything was written to it.
#
function vdev_digest # file
{
	digest -a sha256 $1
}

#
# Run a command in the background and fail the test if it hasn't finished
# within the given number of seconds.  Sets "within_rc" to its exit status.
#
function run_within # seconds description command...
{
	typeset -i tries=$1
	typeset desc=$2
	shift 2

	"$@" >/dev/null 2>&1 &
	typeset -i pid=$!
	while kill -0 $pid 2>/dev/null; do
		if ((tries-- == 0)); then
			log_fail "$desc did not finish in time"
		fi
		sleep 1
	done
	wait $pid
	within_rc=$?
	log_note "$desc returned $within_rc"
}

function failmode_resume_pool
{
	log_must zinject -c all
	log_must zpool clear $TESTPOOL
	if pool_is_suspended $TESTPOOL; then
		log_fail "pool still suspended after zpool clear"
	fi
}

function failmode_cleanup
{
	zinject -c all >/dev/null 2>&1
	if poolexists $TESTPOOL && pool_has_failed $TESTPOOL; then
		# A failed pool can't be destroyed; exporting removes it.
		log_must zpool export -f $TESTPOOL
	elif poolexists $TESTPOOL; then
		# zpool status can miss a suspension; clearing is harmless.
		zpool clear $TESTPOOL >/dev/null 2>&1
		destroy_pool $TESTPOOL
	fi
	rm -f $FAILMODE_VDEV
}

#
# Percentage of a CPU that a (single-threaded) process used over the last
# 5 seconds, from microstate accounting. We can't use the TIME column from
# ps(1) here: a thread spinning in the kernel without ever leaving the CPU
# doesn't have its accumulated time updated, so it looks idle.
#
function proc_cpu_pct # pid
{
	prstat -mLc -p $1 5 2 | nawk '
	    $1 ~ /^[0-9]+$/ { pct = $3 + $4 }
	    END { printf("%d\n", pct) }'
}

#
# Check that a process is blocked (still running, but not using the CPU)
# over a few seconds. Returns 0 if it is blocked, 1 if it has exited, and
# 2 if it is still running and using the CPU (spinning).
#
function proc_is_blocked # pid
{
	typeset pid=$1

	kill -0 $pid 2>/dev/null || return 1
	typeset -i pct=$(proc_cpu_pct $pid)
	kill -0 $pid 2>/dev/null || return 1
	log_note "pid $pid used $pct% of a CPU over 5s"
	((pct >= 50)) && return 2
	return 0
}

#
# The rest of this file is adapted from OpenZFS's failmode.kshlib
# (Copyright (c) 2025, Klara, Inc.): conv=fsync and oflag=sync need GNU dd,
# illumos has no pool state kstat or ZIL kstats, and vdev probes are made to
# fail with label errors, as zinject -T probe isn't available.
#

typeset -A failmode_sync_helper_cmd=(
    ["fsync"]='gnu_dd if=/dev/urandom of=DATAFILE bs=128k count=1 conv=fsync'
    ["msync"]='mmap_write_sync DATAFILE'
    ["osync"]='gnu_dd if=/dev/urandom of=DATAFILE bs=128k count=1 oflag=sync'
    ["syncalways"]='dd if=/dev/urandom of=DATAFILE bs=128k count=1'
)

typeset -A failmode_sync_helper_dsopts=(
    ["syncalways"]="-o sync=always"
)

function failmode_sync_cleanup
{
	# zinject handlers hold the pool, so clear them before exporting
	zinject -c all || true
	if poolexists $TESTPOOL && pool_has_failed $TESTPOOL; then
		zpool export -f $TESTPOOL
	fi
	poolexists $TESTPOOL && zpool clear $TESTPOOL
	destroy_pool $TESTPOOL
}

#
# failmode_sync_test <failmode> <helper>
#
# run a failmode sync test:
# - failmode: wait|continue|death
# - helper: fsync|msync|osync|syncalways
#
function failmode_sync_test
{
	typeset failmode=$1
	typeset helper=$2

	# we'll need two disks, one for the main pool, one for the log
	read -r DISK1 DISK2 _ <<<"$DISKS"

	# file to write to the pool
	typeset datafile="/$TESTPOOL/$TESTFS/datafile"

	# create a single-disk pool with a separate log and the wanted failmode
	log_must zpool create \
	    -f -o failmode=$failmode $TESTPOOL $DISK1 log $DISK2

	# create the test dataset. we bias the ZIL towards the log device to
	# try to ensure that the sync write never involves the main device
	log_must zfs create \
	    -o recordsize=128k -o logbias=latency \
	    ${failmode_sync_helper_dsopts[$helper]} \
	    $TESTPOOL/$TESTFS

	# create the target file. the ZIL head structure is created on first
	# use, and does a full txg wait to finish, which we want to avoid
	log_must gnu_dd if=/dev/zero of=$datafile bs=128k count=1 conv=fsync
	log_must zpool sync

	# inject errors. writes will fail, as will the followup probes
	zinject -d $DISK1 -e io -T write $TESTPOOL
	zinject -d $DISK1 -L pad2 $TESTPOOL
	zinject -d $DISK2 -e io -T write $TESTPOOL
	zinject -d $DISK2 -L pad2 $TESTPOOL

	# run the helper program in the background. the pool should immediately
	# suspend, and the sync op block or fail based on the failmode
	typeset helper_cmd=${failmode_sync_helper_cmd[$helper]/DATAFILE/$datafile}
	log_note "running failmode sync helper: $helper_cmd"
	$helper_cmd &
	typeset -i pid=$!

	# should only take a moment, but give it a chance. a death pool fails
	# rather than suspending
	if [[ $failmode = "death" ]]; then
		failmode_wait_failed $TESTPOOL
	else
		log_note "waiting for pool to suspend"
		typeset -i tries=10
		until pool_is_suspended $TESTPOOL; do
			if ((tries-- == 0)); then
				log_fail "pool didn't suspend"
			fi
			sleep 1
		done
	fi

	# give the sync op a moment to notice the suspend and return
	sleep 1

	# see if the helper program blocked
	typeset -i blocked
	if kill -0 $pid ; then
		blocked=1
		log_note "$helper: blocked in the kernel"
	else
		blocked=0
		log_note "$helper: exited while pool suspended"
	fi

	if [[ $failmode = "death" ]]; then
		# a failed pool can't come back: the only way out is the
		# export, which must not wait for the helper. the helper
		# may still be running only if it is blocked, which fails
		# the test below; don't let the export wait on it.
		((blocked)) && kill -9 $pid
		# zinject handlers hold the pool, so clear them first. that
		# can't revive a failed pool.
		log_must zinject -c all
		log_must zpool export -f $TESTPOOL
		wait $pid
		typeset -i rc=$?

		# the pool comes back with what was synced before it failed
		log_must zpool import $TESTPOOL
		log_must zpool scrub -w $TESTPOOL
		log_must check_pool_status $TESTPOOL "errors" \
		    "No known data errors"
	else
		# bring the pool back online
		zinject -c all
		zpool clear $TESTPOOL

		# program definitely exited now, get its return code
		wait $pid
		typeset -i rc=$?
	fi

	failmode_sync_cleanup

	log_note "$helper: blocked=$blocked rc=$rc"

	# confirm expected results for the failmode
	if [[ $failmode = "wait" ]] ; then
		# - sync op blocked when the pool suspended
		# - after resume, sync op succeeded, helper returned success
		log_must test $blocked -eq 1
		log_must test $rc -eq 0
	elif [[ $failmode = "continue" ]] ; then
		# - helper exited when the pool suspended
		# - sync op returned an error, so helper returned failure
		log_must test $blocked -eq 0
		log_must test $rc -ne 0
	elif [[ $failmode = "death" ]] ; then
		# - helper exited when the pool failed
		# - sync op returned an error: nothing written after the
		#   failure is on disk, so it must not report success
		log_must test $blocked -eq 0
		log_must test $rc -ne 0
	else
		log_fail "impossible failmode: $failmode"
	fi

	# illumos's log_must returns 1 even when the command succeeds
	return 0
}
