#
# Helpers for failing a failmode=death pool at a chosen point: while a
# thread is inside a given function, or while a given write is in flight.
#
# The pool's I/O is slowed with "zinject -D", so that a thread that issues
# I/O stays where it is for a while.  A DTrace program watches for the
# target; when it fires, it makes every write to the pool fail (zinject, via
# system()).  The delayed I/O then completes with an error, and the pool
# fails.  The program also says whether spa_fail() ran before the target
# instance ended ("INSIDE") or after ("AFTER"); a case is tried until it
# lands inside.
#
# Writers sync 128k records in a loop and log each one only once its sync
# returned 0.  After the failure, the pool must export (export -f) within 60
# seconds, import, have every logged record, and scrub clean.
#

PIN_DIR=$TEST_BASE_DIR/pinned
PIN_VD=$PIN_DIR/vdev
PIN_V1=$PIN_VD/v1
PIN_V2=$PIN_VD/v2
PIN_SLOG=$PIN_VD/slog
PIN_SLOW=$PIN_DIR/slow
PIN_D=$PIN_DIR/pin.d
PIN_OUT=$PIN_DIR/pin.out
PIN_WRITER=$PIN_DIR/writer.py
PIN_FS=/$TESTPOOL/$TESTFS
# Another pool, for the slog of the flush case, or to send to and from.
PIN_POOL2=$TESTPOOL1

typeset -a pin_pids
typeset -i pin_npids=0
typeset pin_dpid="" pin_mmp_saved="" pin_writers="" pin_import_dirs=""

function pin_cleanup
{
	typeset p
	for p in ${pin_pids[@]}; do
		kill -9 $p >/dev/null 2>&1
	done
	pin_pids=()
	pin_npids=0
	[[ -n $pin_dpid ]] && kill $pin_dpid >/dev/null 2>&1
	pin_dpid=""
	zinject -c all >/dev/null 2>&1
	pin_mmp_restore
	for p in $TESTPOOL $PIN_POOL2; do
		if poolexists $p; then
			zpool export -f $p >/dev/null 2>&1 ||
			    zpool destroy -f $p >/dev/null 2>&1
		fi
	done
	rm -rf $PIN_DIR
}

#
# The writer: <file> <log> <fsync|dsync>.  Writes record i (a 128k block
# made from i), syncs it, and logs i once the sync returned 0.
#
function pin_mkwriter
{
	log_must mkdir -p $PIN_DIR
	cat > $PIN_WRITER <<'EOF'
import os, sys, hashlib
path, log, mode = sys.argv[1], sys.argv[2], sys.argv[3]
out = open(log, "w", buffering=1)
def rec(i):
	h = hashlib.sha256(b"%d" % i).digest()
	return (h * (131072 // len(h)))
try:
	fd = os.open(path, os.O_RDWR | os.O_CREAT |
	    (os.O_DSYNC if mode == "dsync" else 0), 0o644)
	if mode == "fsync":
		os.fsync(fd)
except OSError as e:
	out.write("err %d\n" % e.errno)
	sys.exit(0)
out.write("created\n")
i = 0
while True:
	try:
		os.pwrite(fd, rec(i), i * 131072)
		if mode == "fsync":
			os.fsync(fd)
	except OSError as e:
		out.write("err %d\n" % e.errno)
		break
	out.write("%d\n" % i)
	i += 1
EOF
}

function pin_bg
{
	"$@" &
	pin_pids[$pin_npids]=$!
	((pin_npids++))
}

function pin_kill_bg
{
	typeset p
	for p in ${pin_pids[@]}; do
		kill -9 $p >/dev/null 2>&1
	done
	pin_pids=()
	pin_npids=0
}

function pin_writer # name fsync|dsync
{
	pin_bg python $PIN_WRITER $PIN_FS/$1 $PIN_DIR/$1.log $2
	pin_writers="$pin_writers $1"
}

#
# Every record that a writer logged is in its file.
#
function pin_verify_writers
{
	typeset w
	for w in $pin_writers; do
		python - $PIN_FS/$w $PIN_DIR/$w.log <<'EOF'
import os, sys, hashlib
path, log = sys.argv[1:3]
lines = [l.strip() for l in open(log)]
acked = [int(l) for l in lines if l.isdigit()]
# A create is durable only with the first write acknowledged after it (an
# O_DSYNC open doesn't commit it).
if not acked:
	print("%s: no writes acknowledged" % path)
	sys.exit(0)
fd = os.open(path, os.O_RDONLY)
bad = 0
for i in acked:
	h = hashlib.sha256(b"%d" % i).digest()
	if os.pread(fd, 131072, i * 131072) != h * (131072 // len(h)):
		bad += 1
print("%s: %d acknowledged, %d missing or wrong" % (path, len(acked), bad))
sys.exit(bad != 0)
EOF
		(($? == 0)) || log_fail "writes acknowledged before the" \
		    "failure were lost"
	done
}

function pin_mkpool # extra vdev args
{
	log_must mkdir -p $PIN_VD
	rm -f $PIN_V1 $PIN_V2
	log_must mkfile 512m $PIN_V1 $PIN_V2
	log_must zpool create -f -o failmode=death $TESTPOOL $PIN_V1 $PIN_V2 \
	    "$@"
	log_must zfs create -o recordsize=128k -o compression=off \
	    $TESTPOOL/$TESTFS
}

function pin_mkslog
{
	rm -rf $PIN_VD
	log_must mkdir -p $PIN_VD
	log_must mkfile 256m $PIN_SLOG
}

function pin_slow # delay_ms vdev...
{
	typeset d=$1 v
	shift
	for v in "$@"; do
		log_must eval "zinject -d $v -D $d:${PIN_LANES:-16} $TESTPOOL \
		    >/dev/null"
	done
}

#
# The commands that make every write to these vdevs fail, labels included.
#
function pin_fault_cmd # vdev...
{
	typeset c="" v l
	for v in "$@"; do
		c="$c zinject -d $v -e io -T write $TESTPOOL >/dev/null;"
	done
	for l in pad2 uber nvlist; do
		for v in "$@"; do
			c="$c zinject -d $v -L $l $TESTPOOL >/dev/null;"
		done
	done
	echo "$c"
}

#
# Let MMP fail the pool: with multihost=on, the MMP thread suspends the pool
# (so a death pool fails) once no MMP write has succeeded for 2 x 100 ms,
# whatever the txg sync is waiting for.  The txg sync itself fails the pool
# only once all of its writes are done, which is too late when they queue
# behind the write we want in flight.
#
function pin_mmp_fast
{
	typeset -i iv=$(echo "zfs_multihost_interval/E" | mdb -k |
	    nawk 'NF > 1 { print $2 }')
	typeset -i fi=$(echo "zfs_multihost_fail_intervals/D" | mdb -k |
	    nawk 'NF > 1 { print $2 }')
	pin_mmp_saved="zfs_multihost_interval/Z 0t$iv
zfs_multihost_fail_intervals/W 0t$fi"
	echo "zfs_multihost_interval/Z 0t100" | mdb -kw >/dev/null ||
	    log_fail "can't set zfs_multihost_interval"
	echo "zfs_multihost_fail_intervals/W 0t2" | mdb -kw >/dev/null ||
	    log_fail "can't set zfs_multihost_fail_intervals"
	log_must zpool set multihost=on $TESTPOOL
}

function pin_mmp_restore
{
	if [[ -n $pin_mmp_saved ]]; then
		echo "$pin_mmp_saved" | mdb -kw >/dev/null
		pin_mmp_saved=""
	fi
}

function pin_d_header
{
	cat <<EOF
#pragma D option quiet
#pragma D option destructive
#pragma D option switchrate=100hz
#pragma D option strsize=2048
inline string pool = "$TESTPOOL";
int fired;
uint64_t inflight, key, t_fire, t_left, t_fail;
BEGIN
{
	printf("ready\\n");
}
EOF
}

function pin_d_trailer
{
	cat <<EOF
fbt::spa_fail:entry
/fired && !t_fail && stringof(args[0]->spa_name) == pool/
{
	t_fail = timestamp;
	printf("spa_fail %d ms after firing: %s\\n",
	    (t_fail - t_fire) / 1000000, t_left ? "AFTER" : "INSIDE");
}
tick-1s
/t_fail && t_left/
{
	exit(0);
}
tick-1s
/t_fail && timestamp - t_fail > 60000000000/
{
	printf("the target never ended\\n");
	exit(0);
}
EOF
}

#
# Fire when the target is entered.  $1: entry probe, $2: predicate, $3: key
# of this instance, $4: the probe where it ends, $5: its key there.  $FAULT
# is the command to run.
#
function pin_d_entry
{
	{
		pin_d_header
		cat <<EOF
$1
/!fired && $2/
{
	fired = 1; key = (uint64_t)($3); t_fire = timestamp;
	system("$FAULT");
	printf("fired: %s key %x\\n", probefunc, key);
}
$4
/fired && !t_left && (uint64_t)($5) == key/
{
	t_left = timestamp;
	printf("ended after %d ms\\n", (t_left - t_fire) / 1000000);
}
EOF
		pin_d_trailer
	} > $PIN_D
}

#
# For writes that can fail without failing the pool (lwb writes): track the
# oldest one in flight, and fire at the start of a txg sync while it still
# is, so that the sync's writes fail the pool.  $1: issue probe, $2:
# predicate, $3: key at issue, $4: done probe, $5: key at done.
#
function pin_d_inflight
{
	{
		pin_d_header
		cat <<EOF
uint64_t t_issue;
int ndone;
$1
/!fired && !inflight && $2/
{
	inflight = (uint64_t)($3);
	t_issue = timestamp;
}
$4
/!fired && inflight && (uint64_t)($5) == inflight/
{
	inflight = 0;
	ndone++;
}
fbt::dsl_pool_sync:entry
/!fired && inflight && stringof(args[0]->dp_spa->spa_name) == pool/
{
	fired = 1; key = inflight; t_fire = timestamp;
	system("$FAULT");
	printf("fired: txg %d with %x in flight, issued %d ms before\\n",
	    args[1], key, (t_fire - t_issue) / 1000000);
	/* If none ended before, the end probe may never match. */
	printf("%d earlier instances ended\\n", ndone);
}
$4
/fired && !t_left && (uint64_t)($5) == key/
{
	t_left = timestamp;
	printf("done after %d ms\\n", (t_left - t_fire) / 1000000);
}
EOF
		pin_d_trailer
	} > $PIN_D
}

function pin_start_d
{
	dtrace -s $PIN_D > $PIN_OUT 2>&1 &
	pin_dpid=$!
	typeset -i t=40
	until grep -q "^ready" $PIN_OUT 2>/dev/null; do
		if ! kill -0 $pin_dpid 2>/dev/null; then
			cat $PIN_OUT
			log_fail "dtrace failed"
		fi
		((t-- == 0)) && log_fail "dtrace didn't start"
		sleep 0.5
	done
}

#
# Wait for the pool to fail; stop DTrace; export, import, check the writers'
# records and scrub.  Sets pin_hit if the failure landed inside the target.
#
function pin_finish
{
	typeset -i t=30
	log_note "waiting for $TESTPOOL to fail"
	until pool_has_failed $TESTPOOL; do
		if ((t-- == 0)) && ! grep -q "^fired" $PIN_OUT; then
			# The target never came up: try again.
			log_note "the target never fired"
			kill $pin_dpid >/dev/null 2>&1
			pin_dpid=""
			pin_kill_bg
			log_must zinject -c all
			pin_mmp_restore
			log_must zpool destroy -f $TESTPOOL
			if poolexists $PIN_POOL2; then
				log_must zpool destroy -f $PIN_POOL2
			fi
			pin_hit=0
			return
		fi
		if ((t < 0)); then
			cat $PIN_OUT
			zpool status -v $TESTPOOL
			log_fail "$TESTPOOL didn't fail"
		fi
		sleep 1
	done
	t=60
	while kill -0 $pin_dpid 2>/dev/null; do
		((t-- == 0)) && break
		sleep 1
	done
	kill $pin_dpid >/dev/null 2>&1
	pin_dpid=""
	cat $PIN_OUT
	grep -q INSIDE $PIN_OUT && pin_hit=1 || pin_hit=0
	pin_kill_bg
	log_must zinject -c all
	pin_mmp_restore

	run_within 60 "zpool export -f of the failed pool" \
	    zpool export -f $TESTPOOL
	log_must test $within_rc -eq 0
	log_must zpool import ${pin_import_dirs:--d $PIN_VD} $TESTPOOL
	pin_verify_writers
	log_must zpool scrub -w $TESTPOOL
	log_must check_pool_status $TESTPOOL "errors" "No known data errors"
	log_must zpool destroy $TESTPOOL
	if poolexists $PIN_POOL2; then
		log_must zpool destroy $PIN_POOL2
	fi
}

#
# Run a case (a function that sets up the pool and the DTrace program) until
# the failure lands inside the target, up to <tries> times.
#
function pin_run # case tries
{
	typeset -i try
	for ((try = 1; try <= $2; try++)); do
		log_note "$1: try $try"
		pin_writers=""
		pin_import_dirs=""
		rm -rf $PIN_VD
		pin_dpid=""
		$1
		[[ -n $pin_dpid ]] || pin_start_d
		typeset -f $1_go >/dev/null && $1_go
		pin_finish
		if ((pin_hit)); then
			log_note "$1: the pool failed inside the target"
			return
		fi
	done
	log_fail "$1: the pool never failed inside the target in $2 tries"
}

#
# Send and receive.
#
PIN_THROTTLE=$PIN_DIR/throttle.py

# throttle.py <MB/s>: copy stdin to stdout at that rate.
function pin_mkthrottle
{
	log_must mkdir -p $PIN_DIR
	cat > $PIN_THROTTLE <<'EOF'
import sys, time
rate = float(sys.argv[1]) * 1048576
i, o = sys.stdin.buffer, sys.stdout.buffer
start = time.time(); n = 0
while True:
	b = i.read(65536)
	if not b:
		break
	o.write(b); n += len(b)
	ahead = n / rate - (time.time() - start)
	if ahead > 0:
		time.sleep(ahead)
EOF
}

# The failing pool, and a healthy one to send to and receive from.
function pin_mkpools
{
	log_must mkdir -p $PIN_VD $PIN_SLOW
	log_must mkfile 1g $PIN_V1 $PIN_V2 $PIN_SLOW/vdev
	log_must zpool create -f -o failmode=death $TESTPOOL $PIN_V1 $PIN_V2
	log_must zpool create -f $PIN_POOL2 $PIN_SLOW/vdev
}

# A file system with 256M of data, and a snapshot of it.
function pin_fill # fs
{
	typeset -i i
	log_must zfs create -o compression=off $1
	for ((i = 0; i < 8; i++)); do
		log_must dd if=/dev/urandom of=/$1/f$i bs=1024k count=32
	done
	log_must zfs snapshot $1@s
}

# Make every write to the pool fail, give the next txg something to write,
# and wait for the pool to fail.
function pin_fail_now
{
	log_must eval "$(pin_fault_cmd $PIN_V1 $PIN_V2)"
	(dd if=/dev/urandom of=/$TESTPOOL/dirty bs=128k count=4;
	    zpool sync $TESTPOOL) >/dev/null 2>&1 &
	failmode_wait_failed $TESTPOOL
}

function pin_export_failed
{
	log_must zinject -c all
	run_within 60 "zpool export -f of the failed pool" \
	    zpool export -f $TESTPOOL
	log_must test $within_rc -eq 0
	log_mustnot poolexists $TESTPOOL
}

function pin_reimport
{
	log_must zpool import -d $PIN_VD $TESTPOOL
	log_must zpool scrub -w $TESTPOOL
	log_must check_pool_status $TESTPOOL "errors" "No known data errors"
}

# The two file systems have the same files, with the same contents.
function pin_same # fs1 fs2
{
	typeset f
	(cd /$1 && for f in $(ls | sort); do
		echo "$f $(digest -a sha256 $f)"
	done) > $PIN_DIR/sums.1
	(cd /$2 && for f in $(ls | sort); do
		echo "$f $(digest -a sha256 $f)"
	done) > $PIN_DIR/sums.2
	if ! cmp -s $PIN_DIR/sums.1 $PIN_DIR/sums.2; then
		diff $PIN_DIR/sums.1 $PIN_DIR/sums.2 | head
		log_fail "$2 differs from $1"
	fi
	log_note "$2 matches $1"
}

# Resume a partial receive into <fs> from its token, or else abort it and
# receive again (send <send-args>).  <fs> then matches <src>.
function pin_finish_recv # src send-args fs
{
	typeset tok=$(zfs get -H -o value receive_resume_token $3 2>/dev/null)
	if [[ -n $tok && $tok != - ]]; then
		log_note "resuming the receive into $3"
		log_must eval "zfs send -t $tok | zfs recv -s $3"
	else
		log_note "no resume token on $3: receiving it again"
		zfs recv -A $3 >/dev/null 2>&1
		log_must eval "zfs send $2 | zfs recv -F $3"
	fi
	pin_same $1 $3
}
