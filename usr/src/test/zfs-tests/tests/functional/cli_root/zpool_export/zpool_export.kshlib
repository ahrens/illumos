. $STF_SUITE/tests/functional/cli_root/zpool_export/zpool_export.cfg

#
# For cleanup: a failed pool can't be destroyed, since it can't write the
# labels that would mark it destroyed, so export it and clear its disks'
# labels instead.
#
function hardforce_cleanup_pool # pool disk...
{
	typeset pool=$1
	shift

	poolexists $pool || return 0
	if pool_has_failed $pool; then
		zinject -c all >/dev/null 2>&1
		log_must zpool export $pool
		labelclear_disks "$@"
	else
		destroy_pool $pool
	fi
}
